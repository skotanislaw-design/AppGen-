# --- Backend ---
# Claude API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the audit pipeline (default: claude-opus-4-8)
NOMOS_AUDIT_MODEL=claude-opus-4-8

# Optional bearer token protecting the API. If empty, the API is open
# (suitable only for internal/localhost deployments).
NOMOS_AUDIT_API_KEY=

# Comma-separated allowed CORS origins
NOMOS_AUDIT_CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000
